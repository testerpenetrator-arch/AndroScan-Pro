@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e8f7ff;background:#030611;font-synthesis:none;--bg:#030611;--panel:#080f20;--panel2:#0b1730;--line:#123a53;--cyan:#00f5ff;--pink:#ff2bd6;--purple:#9b5cff;--green:#00ff9c;--muted:#8ca7c3;--danger:#ff3864}*{box-sizing:border-box}body{margin:0;min-width:320px;min-height:100vh;background:radial-gradient(ellipse at 80% 0%,#101b49 0,transparent 35%),radial-gradient(ellipse at 10% 35%,#071b2b 0,transparent 38%),var(--bg)}button,input,select{font:inherit}.login{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 50% 45%,#11133b 0,transparent 42%)}.login-card{width:min(440px,100%);padding:34px;background:linear-gradient(145deg,#0a1429ee,#060918f5);border:1px solid #00d9ff88;border-radius:20px;box-shadow:0 0 30px #00d9ff17,0 0 70px #ff2bd60d,inset 0 0 25px #11264a66}.brand{font-weight:900;letter-spacing:.08em;font-size:25px;color:#f4fbff;text-shadow:0 0 15px #00f5ff40}.brand span{background:linear-gradient(90deg,var(--cyan),var(--purple),var(--pink));-webkit-background-clip:text;background-clip:text;color:transparent}.login-card p{color:var(--muted);margin:8px 0 28px}.login-card input,.header-actions select{width:100%;background:#040a18;color:#e8f7ff;border:1px solid #17516b;border-radius:10px;padding:12px;margin-bottom:12px;outline:none}.login-card input:focus,.admin-form input:focus{border-color:var(--cyan);box-shadow:0 0 0 2px #00f5ff1b}.login-card button,.app button:not(.ghost){border:1px solid var(--cyan);border-radius:9px;padding:11px 16px;background:linear-gradient(90deg,#00d9e9,#0089ad);color:#001019;font-weight:800;cursor:pointer;box-shadow:0 0 18px #00eaff20}.login-card button{width:100%}.app{max-width:1450px;margin:auto;padding:28px}.app header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:30px;padding:17px 20px;background:#070d1cbb;border:1px solid #123c56;border-radius:15px;box-shadow:0 0 25px #00eaff0a}.app header small{color:var(--muted)}.header-actions{display:flex;gap:10px;align-items:center}.header-actions select{margin:0;min-width:210px}.ghost{background:#0a1426;color:#c7d5e6;border:1px solid #29405e;border-radius:9px;padding:11px 16px;cursor:pointer}.hero{padding:10px 0 24px}.eyebrow{font-size:11px;color:var(--cyan);font-weight:800;letter-spacing:.15em}.hero h1{font-size:clamp(27px,4vw,38px);margin:8px 0;text-shadow:0 0 22px #00f5ff20}.hero p{color:var(--muted);margin:0}.metrics{display:grid;grid-template-columns:repeat(7,1fr);gap:12px;margin-bottom:20px}.metric,.panel{background:linear-gradient(145deg,#0a1427ed,#060b18f2);border:1px solid #16405a;border-radius:15px;box-shadow:inset 0 0 22px #10244822}.metric{padding:17px;position:relative;overflow:hidden}.metric:before{content:"";position:absolute;left:0;top:0;width:3px;height:100%;background:linear-gradient(var(--cyan),var(--purple),var(--pink))}.metric span{font-size:12px;color:var(--muted)}.metric strong{display:block;font-size:28px;margin-top:9px;color:#f4fbff;text-shadow:0 0 16px #00eaff22}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{overflow:hidden}.panel-title{display:flex;justify-content:space-between;padding:18px 20px;border-bottom:1px solid #123047}.panel-title h2{font-size:16px;margin:0}.panel-title span{color:var(--cyan)}.row{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:15px 20px;border-bottom:1px solid #10243a}.row:last-child{border-bottom:0}.row b{font-size:13px}.row small{display:block;color:#7792ad;font-size:11px;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:360px}.status,.severity,.priority{font-size:10px;font-weight:800;padding:5px 8px;border-radius:999px;background:#13233b}.severity.critical{background:#481329;color:#ff7c9b;border:1px solid #ff386455}.severity.high{background:#3b2417;color:#ffc17d}.severity.medium{background:#3b3418;color:#f4dc78}.severity.low{color:var(--cyan)}.severity.info{color:#9aaabd}.status.completed{color:var(--green)}.status.failed{color:#ff8d9e}.status.running,.status.preparing,.status.processing_results{color:var(--cyan)}.status.queued{color:#c4a5ff}.empty,.loading{padding:35px;color:#7893ae;text-align:center}.error{color:#ff9aa9;font-size:13px;margin-top:12px}.banner{background:#321821;border:1px solid #69313d;padding:12px;border-radius:10px;margin-bottom:15px}.admin-panel{margin-top:22px}.admin-note{color:#9aa9bc;font-size:.9rem;line-height:1.5}.admin-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin:18px 0}.admin-form label{display:grid;gap:7px;color:#aab8ca;font-size:.88rem}.admin-form input{min-width:0;width:100%;background:#050b19;color:#eef4fa;border:1px solid #17516b;border-radius:8px;padding:10px}.admin-toggles{display:flex;flex-wrap:wrap;gap:14px 24px;margin:16px 0}.admin-toggles label{display:flex;align-items:center;gap:8px;color:#d5deea;font-size:.9rem}.admin-panel h3{margin-top:24px}.admin-panel button{margin:8px 0}.success{color:var(--green)}@media(max-width:1100px){.metrics{grid-template-columns:repeat(4,1fr)}}@media(max-width:760px){.app{padding:12px}.app header,.grid{display:block}.header-actions{margin-top:18px}.header-actions select{flex:1}.panel{margin-bottom:18px}.metrics{grid-template-columns:repeat(2,1fr)}.hero h1{font-size:28px}.row{padding:12px;gap:8px}}

# Plantilla: NO usar literalmente. Ejecuta scripts/init-secrets.sh para crear .env.
APP_NAME=AndroScan API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://androscan:REEMPLAZAR_PASSWORD@postgres:5432/androscan
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/apks
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=androscan
S3_SECRET_KEY=REEMPLAZAR_SECRETO_S3
S3_BUCKET=androscan-apks
S3_REGION=us-east-1
JWT_SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_APK_SIZE_MB=100
SANDBOX_IMAGE=androscan/sandbox-tools:0.1
SANDBOX_CPU=1.0
SANDBOX_MEMORY_MB=1024
SANDBOX_PIDS=128
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_STORAGE_MB=2048
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD

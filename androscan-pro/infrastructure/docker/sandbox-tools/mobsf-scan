#!/usr/bin/env python3
"""Run MobSF static analysis entirely inside the isolated container."""
import json
import os
import subprocess
import time
import urllib.request

import requests

BASE = "http://127.0.0.1:8000"
APK = "/work/input.apk"
OUT = "/work/mobsf"
os.makedirs(OUT, exist_ok=True)

server = subprocess.Popen(
    ["python", "manage.py", "runserver", "127.0.0.1:8000", "--noreload"],
    cwd="/opt/Mobile-Security-Framework-MobSF",
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
try:
    for _ in range(60):
        try:
            urllib.request.urlopen(BASE, timeout=1)
            break
        except Exception:
            time.sleep(1)
    else:
        raise RuntimeError("MobSF no inició dentro del tiempo esperado")

    secret_candidates = [
        "/home/mobsf/.MobSF/secret",
        "/root/.MobSF/secret",
    ]
    api_key = next((open(p, encoding="utf-8").read().strip() for p in secret_candidates if os.path.exists(p)), None)
    if not api_key:
        raise RuntimeError("No fue posible obtener la API key de MobSF")

    headers = {"Authorization": api_key}
    with open(APK, "rb") as fh:
        upload = requests.post(
            BASE + "/api/v1/upload",
            files={"file": ("input.apk", fh, "application/vnd.android.package-archive")},
            headers=headers,
            timeout=120,
        )
    upload.raise_for_status()
    upload_data = upload.json()

    scan = requests.post(BASE + "/api/v1/scan", data=upload_data, headers=headers, timeout=120)
    scan.raise_for_status()

    report = requests.post(
        BASE + "/api/v1/report_json",
        data={"hash": upload_data.get("hash")},
        headers=headers,
        timeout=300,
    )
    report.raise_for_status()
    with open(os.path.join(OUT, "report.json"), "w", encoding="utf-8") as fh:
        json.dump(report.json(), fh, ensure_ascii=False, indent=2)

    print(json.dumps({"status": "completed", "hash": upload_data.get("hash")}))
finally:
    server.terminate()
    try:
        server.wait(timeout=10)
    except subprocess.TimeoutExpired:
        server.kill()
